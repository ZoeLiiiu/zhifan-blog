# Sites 运行时的管理员邮箱，多个邮箱用英文逗号分隔。
ADMIN_EMAILS=your-email@example.com

# ECS 私有后台的 OSS 媒体存储。正式值写入服务器的 /etc/zhifan-admin.env，
# 推荐绑定 ECS 实例 RAM 角色，避免在服务器保存永久 AccessKey。
OSS_BUCKET=your-public-media-bucket
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_PUBLIC_BASE_URL=https://your-public-media-bucket.oss-cn-hangzhou.aliyuncs.com
OSS_USE_ECS_RAM_ROLE=true
# 可选；留空时从 ECS 元数据服务自动发现已绑定的角色名称。
OSS_ECS_RAM_ROLE_NAME=
# 默认优先 IMDSv2，失败时按阿里云 SDK 的默认行为回退 IMDSv1。
# 实例切换为“仅加固模式”后可设为 true。
OSS_ECS_DISABLE_IMDSV1=false
# 仅用于本地自动化测试；生产环境保持默认值。
OSS_ECS_METADATA_BASE_URL=http://100.100.100.200/latest

# 仅为兼容已有部署保留。使用 ECS 实例 RAM 角色时全部留空。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SECURITY_TOKEN=
